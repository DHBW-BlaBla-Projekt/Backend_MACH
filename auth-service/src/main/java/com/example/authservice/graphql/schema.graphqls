# ==================== Input Types ====================
input RegisterInput {
    username: String!
    password: String!
}

input LoginInput {
    username: String!
    password: String!
}

# ==================== Output Types ====================
type AuthPayload {
    accessToken: String
    refreshToken: String
    username: String!
    role: String!
    active: Boolean!
}

type UserResponse {
    id: ID!
    username: String!
    role: String!
    active: Boolean!
}

# Generic response wrapper for mutations
type MutationResult {
    success: Boolean!
    data: AuthPayload
    errors: [String!]!
}

# ==================== Query Type ====================
type Query {
    currentUser: AuthPayload
    user(username: String!): UserResponse
}

# ==================== Mutation Type ====================
type Mutation {
    register(input: RegisterInput!): MutationResult!
    login(input: LoginInput!): MutationResult!
    refreshToken(refreshToken: String!): MutationResult!
    logout(refreshToken: String!): Boolean!
}
