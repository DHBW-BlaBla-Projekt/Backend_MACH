type AuthPayload {
    accessToken: String
    refreshToken: String
    username: String!
    role: String!
    active: Boolean!
}

type AuthError {
    errors: [String!]!
}

input RegisterInput {
    username: String!
    password: String!
}

input LoginInput {
    username: String!
    password: String!
}

union AuthResult = AuthPayload | AuthError

type Query {
    _empty: Boolean
}

type Mutation {
    register(input: RegisterInput!): AuthResult!
    login(input: LoginInput!): AuthResult!
    refreshToken(refreshToken: String!): AuthResult!
    logout(refreshToken: String!): Boolean!
}
